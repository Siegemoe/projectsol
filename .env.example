# Client-visible
NEXT_PUBLIC_APP_NAME=Sol
NEXT_PUBLIC_APP_ENV=development
# Supabase (set in Vercel → Environment Variables; mirror to .env.local for dev)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
# Base URL for server redirects/fetches (set to your prod URL in Vercel)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Show magic link on sign-in (1 to enable in dev; keep 0 in production for Google-only)
NEXT_PUBLIC_SHOW_MAGIC_LINK=0

# Server-only (OpenRouter)
# Add these in Vercel → Project → Settings → Environment Variables (Preview + Production)
# Mirror to .env.local for local dev (do NOT commit .env.local)
OPENROUTER_API_KEY=sk-or-xxx
# Optional; used for HTTP-Referer in requests (helps OpenRouter analytics / auth)
SITE_URL=http://localhost:3000

# Legacy OpenAI (unused by new /api/sol-chat route)
OPENAI_API_KEY=sk-xxx
# Optional (defaults to api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# GPT-5 by default; override if needed
OPENAI_MODEL=gpt-5

# API hardening flags (mirror to .env.local for local dev)
# 1 = require Supabase-authenticated user for /api/* endpoints where enforced
REQUIRE_AUTH_FOR_API=1
# 1 = enable in-memory rate limiting on Edge routes (best-effort)
RATE_LIMIT_ENABLED=1
# Comma-separated list of allowed emails and/or domains for Alpha access (leave empty to allow all)
EMAIL_ALLOWLIST=
# Comma-separated allowlist of models accepted by /api/sol-chat
OPENROUTER_ALLOWED_MODELS=deepseek/deepseek-chat

# Gmail Integration (server-only; mirror to .env.local for dev; do NOT commit .env.local)
# 1 = enable Gmail integration
ENABLE_GMAIL=1
# Google Cloud OAuth2 credentials (Gmail API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# 32-byte symmetric key for encrypting refresh tokens (base64 or hex)
ENCRYPTION_KEY=change-me
