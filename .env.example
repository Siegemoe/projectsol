# Client-visible
NEXT_PUBLIC_APP_NAME=Sol
NEXT_PUBLIC_APP_ENV=development
# Supabase (set in Vercel → Environment Variables; mirror to .env.local for dev)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
# Base URL for server redirects/fetches (set to your prod URL in Vercel)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Server-only (OpenRouter)
# Add these in Vercel → Project → Settings → Environment Variables (Preview + Production)
# Mirror to .env.local for local dev (do NOT commit .env.local)
OPENROUTER_API_KEY=sk-or-xxx
# Optional; used for HTTP-Referer in requests (helps OpenRouter analytics / auth)
SITE_URL=http://localhost:3000

# Legacy OpenAI (unused by new /api/sol-chat route)
OPENAI_API_KEY=sk-xxx
# Optional (defaults to api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# GPT-5 by default; override if needed
OPENAI_MODEL=gpt-5
